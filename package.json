{
  "name": "product-mole",
  "version": "0.2.8",
  "description": "A portable, local-first context operating system for product managers and AI assistants.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplybenuk/product-mole.git"
  },
  "bugs": {
    "url": "https://github.com/simplybenuk/product-mole/issues"
  },
  "homepage": "https://github.com/simplybenuk/product-mole#readme",
  "bin": {
    "mole": "./cli/mole.mjs"
  },
  "files": [
    "LICENSE",
    "0-bootstrap",
    "1-routing",
    "2-summaries",
    "3-indexes",
    "4-context",
    "5-evidence",
    "6-raw",
    "agents.md",
    "cli",
    "docs",
    "examples",
    "governance/change-log.md",
    "governance/contribution-guide.md",
    "governance/input-queue.md",
    "governance/metrics",
    "governance/quality-checklist.md",
    "governance/run-receipts/README.md",
    "lib",
    "spec",
    "templates",
    "ui",
    "CHANGELOG.md",
    "README.md",
    "VERSION",
    "mole.instance-template.yaml",
    "upgrade-ownership.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test cli/test/mole.test.mjs",
    "check:versions": "node scripts/check-release-consistency.mjs",
    "check:package": "node scripts/verify-package.mjs",
    "check:release": "node scripts/check-release-consistency.mjs --release && npm run check:package",
    "check:release:tag": "node scripts/check-release-consistency.mjs --release --require-tag && node scripts/verify-package.mjs --from-head"
  },
  "license": "MIT"
}
