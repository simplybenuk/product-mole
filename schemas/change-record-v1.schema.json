{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-mole.local/schemas/change-record-v1.schema.json",
  "title": "Mole change and outcome record v1",
  "description": "Structural schema. Runtime validation additionally checks provenance coverage, calendar dates and computed gaps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "release_id",
    "source",
    "title",
    "problem",
    "hypothesis",
    "expected_outcome",
    "baseline",
    "target",
    "review_window",
    "observed_outcome",
    "confidence",
    "attribution_caveats",
    "learning",
    "next_decision",
    "success_signals",
    "guardrails",
    "evidence",
    "dates",
    "delivery_status",
    "review_status",
    "outcome_status",
    "gaps",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "release_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "problem": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "hypothesis": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "expected_outcome": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "baseline": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "target": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "review_window": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "observed_outcome": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "attribution_caveats": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "learning": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "next_decision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "success_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned",
        "released",
        "review_due",
        "reviewed"
      ],
      "properties": {
        "planned": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          ]
        },
        "released": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          ]
        },
        "review_due": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          ]
        },
        "reviewed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          ]
        }
      }
    },
    "delivery_status": {
      "enum": [
        "planned",
        "released",
        "unknown"
      ]
    },
    "review_status": {
      "enum": [
        "not_due",
        "review_due",
        "reviewed",
        "unknown"
      ]
    },
    "outcome_status": {
      "enum": [
        "not_measured",
        "no_data",
        "inconclusive",
        "positive",
        "negative",
        "mixed",
        "unknown"
      ]
    },
    "gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "problem",
          "hypothesis",
          "expected_outcome",
          "success_signals",
          "baseline",
          "target",
          "review_window",
          "guardrails"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "locator",
            "method"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "source_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "method": {
              "enum": [
                "copied",
                "generated",
                "defaulted"
              ]
            }
          }
        }
      }
    }
  }
}
