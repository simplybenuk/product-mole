{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-mole.local/schemas/source-record-v1.schema.json",
  "title": "Mole source record version 1",
  "description": "A stable, local-first provenance record for one source file or external source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_revision",
    "source_id",
    "source_type",
    "media_type",
    "original_date",
    "captured_at",
    "captured_by",
    "channel",
    "source_reference",
    "original_path",
    "current_path",
    "path_history",
    "content_hash",
    "byte_size",
    "content_history",
    "attachments",
    "parent_source_id",
    "visibility",
    "retention",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_revision": { "type": "integer", "minimum": 1 },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_type": {
      "type": "string",
      "enum": ["note", "file", "attachment", "export", "external", "other"]
    },
    "media_type": { "type": ["string", "null"] },
    "original_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "captured_at": { "type": "string", "format": "date-time" },
    "captured_by": { "type": "string", "minLength": 1 },
    "channel": { "type": ["string", "null"] },
    "source_reference": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "original_path": { "type": ["string", "null"] },
    "current_path": { "type": ["string", "null"] },
    "path_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "valid_from", "valid_to", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_to": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "content_hash": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "byte_size": { "type": ["integer", "null"], "minimum": 0 },
    "content_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recorded_at", "hash", "byte_size", "change_type", "reason"],
        "properties": {
          "recorded_at": { "type": "string", "format": "date-time" },
          "hash": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": { "const": "sha256" },
              "value": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "byte_size": { "type": "integer", "minimum": 0 },
          "change_type": { "type": "string", "minLength": 1 },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "relationship", "label"],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "relationship": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "parent_source_id": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^src_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "visibility": { "type": "string", "minLength": 1 },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "review_after", "expires_at"],
      "properties": {
        "mode": { "type": "string", "enum": ["retain", "archive", "review"] },
        "review_after": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
